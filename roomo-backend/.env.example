# Required existing settings
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/roomo_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_URL="http://localhost:5173"
PORT=5001

# SMTP settings for guest email verification (use credentials from your email provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password-or-app-password"
EMAIL_FROM="ROOMO <no-reply@example.com>"

# Optional Google sign-in
GOOGLE_CLIENT_ID=""
