# Required existing settings
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/roomo_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_URL="http://localhost:5173"
PORT=5001

# Web Push notifications for the ROOMO Driver Portal (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@roomo.in"

# SMTP settings for guest email verification (use credentials from your email provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password-or-app-password"
EMAIL_FROM="ROOMO <no-reply@example.com>"

# Optional Google sign-in
GOOGLE_CLIENT_ID=""

# Twilio SMS + WhatsApp (set credentials in your private .env; never commit real secrets)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# WhatsApp template Content SIDs approved/configured in Twilio Content Template Builder
TWILIO_WHATSAPP_OTP_CONTENT_SID=""
TWILIO_WHATSAPP_RESERVATION_CONTENT_SID=""
