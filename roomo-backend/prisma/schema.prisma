// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name")
  role         String     @default("OWNER")
  email        String     @unique
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  properties   Property[]

  @@map("owners")
}

model GuestUser {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  authProvider String   @default("EMAIL") @map("auth_provider")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("guest_users")
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @db.Uuid @map("owner_id")
  title         String
  description   String         @db.Text
  propertyType  String         @map("property_type")
  address       String
  city          String
  state         String
  country       String         @default("India")
  postalCode    String?        @map("postal_code")
  nightlyPrice  Decimal        @db.Decimal(10, 2) @map("nightly_price")
  maxGuests     Int            @map("max_guests")
  bedrooms      Int            @default(1)
  bathrooms     Int            @default(1)
  amenities     Json           @default("[]")
  nearbyLandmarks Json         @default("[]") @map("nearby_landmarks")
  perks         Json           @default("[]")
  isFeatured    Boolean        @default(false) @map("is_featured")
  featuredSortOrder Int        @default(0) @map("featured_sort_order")
  status        PropertyStatus @default(DRAFT)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  owner         Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        PropertyImage[]

  @@index([ownerId])
  @@index([city, status])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid @map("property_id")
  imageUrl   String   @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model HomepageConfig {
  id          Int      @id @default(1)
  draft       Json?
  published   Json?
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("homepage_config")
}

model GalleryItem {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String   @default("") @db.Text
  type         String
  sourceType   String   @map("source_type")
  mediaUrl     String   @map("media_url") @db.Text
  thumbnailUrl String?  @map("thumbnail_url") @db.Text
  status       String   @default("DRAFT")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, type, sortOrder])
  @@map("gallery_items")
}

model GalleryConfig {
  id          Int      @id @default(1)
  initialized Boolean  @default(false)
  sampleVideosInitialized Boolean @default(false) @map("sample_videos_initialized")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gallery_config")
}
